# =============================================================
# NBK Engage - environment configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file.
# =============================================================

# ---- Primary database connection (required) ----------------
# NBK Engage talks to Postgres directly (via SQLAlchemy/psycopg2)
# so it can run transactional, multi-row-safe writes for live
# session state, responses and scoring.
#
# Get this from: Supabase Dashboard -> Project Settings -> Database
#   -> "Connection string" -> URI (use the "Session pooler" or
#   "Transaction pooler" string for best results with Streamlit).
#
# Example:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---- Supabase project metadata (optional, for future use) ---
# Reserved for future features (Supabase Storage for question
# images, Supabase Realtime channels, etc). NOT required for the
# MVP's core functionality, which uses DATABASE_URL directly.
# NEVER expose the service-role key to participant-facing code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Application settings ------------------------------------
APP_NAME=NBK Engage

# Base URL used to build the participant join link / QR code.
# Leave this at the localhost placeholder for local classroom use --
# the app automatically detects this machine's LAN IP instead (e.g.
# http://192.168.1.23:8501) so phones on the same Wi-Fi can scan the
# QR code with zero configuration. Only change this if you deploy
# the app to a real public URL (e.g. https://engage.yourdomain.com
# or your Streamlit Community Cloud URL) -- once it's anything other
# than the placeholder below, that exact URL is used instead of LAN
# auto-detection. See README.md "Network access" for details.
APP_BASE_URL=http://localhost:8501
APP_PORT=8501

# Admin password gate for the Admin area (simple MVP auth).
ADMIN_PASSWORD=changeme

# Polling interval (seconds) used by host/participant screens to
# refresh shared session state from the database.
POLL_INTERVAL_SECONDS=2
